{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableAutoMode": "disable",
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -fR *)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh * pr merge)",
      "Bash(gh * pr merge *)",
      "Bash(gh * pr review)",
      "Bash(gh * pr review *)",
      "Bash(gh * pr comment)",
      "Bash(gh * pr comment *)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr:*)",
      "Bash(gh api:*)",
      "Bash(python3:*)",
      "Bash(git * push)",
      "Bash(git * push *)"
    ]
  }
}
